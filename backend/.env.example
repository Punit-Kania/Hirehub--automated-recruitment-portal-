# Set this in Render Environment > Environment Variables.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/hirehub
# Set to your Vercel frontend origin, without a trailing slash.
FRONTEND_URL=https://YOUR-PROJECT.vercel.app
# Optional comma-separated extra origins, such as a preview or custom domain.
# FRONTEND_URLS=https://YOUR-PROJECT.vercel.app,https://your-custom-domain.example
